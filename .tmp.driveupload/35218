<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Hey Cohen — Case Study Preview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
<style>
  :root {
    --deep-purple: #2d255c;
    --neon-green: #88FF00;
    --cyan: #00ffff;
    --pink: #ff0055;
    --ink: #17143a;
    --slate: #5b5b6b;
    --muted: #8a8a98;
    --line: #ececf0;
    --surface: #ffffff;
    --radius: 18px;
    --font-sans: 'Source Sans 3', sans-serif;
    --font-serif: 'PT Serif', serif;
    --font-mono: 'Source Code Pro', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body { font-family: var(--font-sans); color: var(--ink); background: #fff; -webkit-font-smoothing: antialiased; }

  /* ---------- NAV ---------- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 40px; background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
  }
  .nav__links { display: flex; gap: 26px; align-items: center; }
  .nav__link { font-size: 14px; letter-spacing: 0.02em; color: var(--ink); text-decoration: none; opacity: 0.85; }
  .nav__link:hover { opacity: 1; }
  .nav__logo { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }
  .nav__logo span { color: var(--neon-green); }

  /* ---------- HERO ---------- */
  .hero {
    background: linear-gradient(180deg, #191636 0%, #2d255c 100%);
    color: #fff; padding: 150px 40px 80px; position: relative; overflow: hidden;
  }
  .hero::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 30%, rgba(136,255,0,0.15) 0%, transparent 65%);
  }
  .hero__inner { position: relative; z-index: 2; max-width: 1100px; margin: 0 auto; }
  .hero__company {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--neon-green); font-weight: 600; margin-bottom: 18px;
  }
  .hero__title { font-family: var(--font-serif); font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 20px; }
  .hero__summary { max-width: 760px; font-size: clamp(1.1rem, 1.8vw, 1.35rem); font-weight: 300; line-height: 1.6; color: rgba(255,255,255,0.85); }
  .hero__meta { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 34px; font-size: 0.9rem; color: rgba(255,255,255,0.6); }
  .hero__meta b { color: #fff; font-weight: 600; display: block; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 3px; }
  .hero__cta { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px;
    border-radius: 999px; font-weight: 600; font-size: 0.95rem; text-decoration: none; border: none; cursor: pointer;
    transition: transform .15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn--primary { background: var(--neon-green); color: #000; }
  .btn--ghost-light { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.35); }

  /* ---------- BODY ---------- */
  .body { max-width: 1100px; margin: 0 auto; padding: 70px 40px 40px; }
  .block { margin-bottom: 56px; }
  .block__heading { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .block__text { color: var(--slate); font-size: 1.08rem; font-weight: 300; line-height: 1.7; }
  .block__text p { margin-bottom: 18px; }
  .block__text b { color: var(--ink); font-weight: 600; }

  /* Feature cards */
  .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 8px; }
  .feature { border: 1px solid var(--line); border-radius: 14px; padding: 22px; }
  .feature__title { font-weight: 700; font-size: 1.05rem; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .feature__title .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--neon-green); }
  .feature p { color: var(--slate); font-size: 0.95rem; font-weight: 300; line-height: 1.6; }

  /* Screenshots */
  .shots { display: flex; flex-direction: column; gap: 28px; margin-top: 8px; }
  .shot { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .shot__frame { aspect-ratio: 16/9; background: linear-gradient(135deg, #f4f4f7, #e9e9ef); display: flex; align-items: center; justify-content: center; color: var(--muted); font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.05em; }
  .shot__caption { padding: 14px 20px; color: var(--slate); font-size: 0.95rem; font-weight: 300; line-height: 1.6; border-top: 1px solid var(--line); }

  /* Impact */
  .impact { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .impact__card { background: var(--deep-purple); color: #fff; border-radius: 16px; padding: 28px; }
  .impact__value { font-family: var(--font-serif); font-size: 2.4rem; font-weight: 700; color: var(--neon-green); margin-bottom: 6px; }
  .impact__label { color: rgba(255,255,255,0.7); font-size: 0.95rem; font-weight: 300; }
  .impact__context { margin-top: 20px; color: var(--slate); font-size: 1.02rem; font-weight: 300; line-height: 1.7; }

  /* Demo banner */
  .demo { background: linear-gradient(180deg, #191636 0%, #2d255c 100%); border-radius: 20px; padding: 48px; text-align: center; color: #fff; margin-top: 20px; }
  .demo h3 { font-family: var(--font-serif); font-size: 1.8rem; margin-bottom: 12px; }
  .demo p { color: rgba(255,255,255,0.7); max-width: 560px; margin: 0 auto 24px; font-weight: 300; line-height: 1.6; }

  .footer { border-top: 1px solid var(--line); padding: 48px 40px; text-align: center; color: var(--muted); font-size: 0.9rem; }
  .footer a { color: var(--ink); }

  @media (max-width: 800px) {
    .nav { padding: 14px 20px; }
    .hero { padding: 120px 20px 60px; }
    .body { padding: 50px 20px 30px; }
    .features, .impact { grid-template-columns: 1fr; }
    .demo { padding: 32px 20px; }
  }
</style>
</head>
<body>

